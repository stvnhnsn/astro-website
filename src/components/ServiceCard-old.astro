---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<div class="service-card">
  <h3>{title}</h3>
  <p>{description}</p>
</div>
<style>
  .service-card {
    background-color: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    text-align: center;
  }
  .service-card h3 {
    color: #333333;
    margin-bottom: 0.5rem;
  }
  .service-card p {
    color: #708090;
  }
</style>