---
import { BUSINESS_NAME, CONTACT_EMAIL, CONTACT_PHONE, BUSINESS_ADDRESS } from "../site-config";
---
<footer>
  <p>&copy; {new Date().getFullYear()} {BUSINESS_NAME}. All rights reserved.</p>
  <p>Contact: <a href="mailto:{CONTACT_EMAIL}">{CONTACT_EMAIL}</a> | {CONTACT_PHONE}</p>
  <p>{BUSINESS_ADDRESS}</p>
</footer>
<style>
  footer {
    text-align: center;
    padding: 2rem;
    background-color: #333333;
    color: white;
    margin-top: 2rem;
  }
  footer a {
    color: white;
    text-decoration: none;
  }
  footer a:hover {
    text-decoration: underline;
  }
</style>