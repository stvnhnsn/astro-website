---
import MainLayout from "../layouts/MainLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { SERVICES } from "../site-config";

const serviceDescriptions = {
  "Remodeling": "Transform your existing spaces into the home of your dreams with our comprehensive remodeling services. From kitchens and bathrooms to full home renovations, we handle every detail with precision and care.",
  "Cabinet Building": "Custom-built cabinets designed to your exact specifications. We craft beautiful and functional cabinetry for kitchens, bathrooms, offices, and more, using high-quality materials and expert techniques.",
  "Specialized Woodworking": "Bring your unique visions to life with our specialized woodworking services. Whether it's custom furniture, intricate millwork, or unique architectural elements, our skilled craftsmen deliver unparalleled artistry and precision.",
};
---
<MainLayout title="Services">
  <main>
    <section class="services-hero">
      <h1>Our Services</h1>
      <p>Crafting Excellence in Every Project</p>
    </section>
    <section class="services-grid">
      {
        SERVICES.map((service) => (
          <ServiceCard title={service} description={serviceDescriptions[service]} />
        ))
      }
    </section>
  </main>
</MainLayout>

<style>
  .services-hero {
    background-color: #333333;
    color: white;
    text-align: center;
    padding: 4rem 1rem;
    margin-bottom: 2rem;
  }
  .services-hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .services-hero p {
    font-size: 1.5rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>