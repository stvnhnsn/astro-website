---
import MainLayout from "../layouts/MainLayout.astro";
import { BUSINESS_NAME } from "../site-config";
---
<MainLayout title="Home">
  <main>
    <section class="hero">
      <h1>Your Vision, Our Craft.</h1>
      <p>Building Dreams, One Project at a Time.</p>
      <a href="/contact" class="cta-button">Get a Free Estimate</a>
    </section>
    <section class="about">
      <h2>About {BUSINESS_NAME}</h2>
      <p>We are a dedicated team of craftsmen passionate about bringing your construction and woodworking visions to life. With years of experience and a commitment to quality, we specialize in remodeling, custom cabinet building, and intricate specialized woodworking projects.</p>
    </section>
  </main>
</MainLayout>

<style>
  .hero {
    background-color: #708090;
    color: white;
    text-align: center;
    padding: 4rem 1rem;
    margin-bottom: 2rem;
  }
  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .hero p {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }
  .cta-button {
    background-color: var(--color-accent);
    color: white;
    padding: 0.8rem 2rem;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    transition: background-color 0.3s ease;
  }
  .cta-button:hover {
    background-color: var(--color-accent);
    filter: brightness(1.1);
  }
  .about {
    padding: 2rem 1rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .about h2 {
    color: var(--color-charcoal);
    margin-bottom: 1rem;
  }
  .about p {
    color: var(--color-slate);
    line-height: 1.6;
  }
</style>
