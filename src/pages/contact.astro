---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us">
  <main class="contact-page-main">
    <section class="contact-hero">
      <h1>Get in Touch</h1>
      <p>Please contact us if you would like a quote or have any questions.</p>
      <hr class="contact-hero-divider" />
    </section>
    <section class="contact-form-section">
      <form
        id="contact-form"
        name="contact-form"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/success"
        class="contact-form"
      >
        <p class="hidden" style="display: none;">
          <label>
            Do not fill this out if you are human:
            <input name="bot-field" />
          </label>
        </p>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Name"
          required
          aria-label="Name"
        />
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Email"
          required
          aria-label="Email"
          autocapitalize="none"
          autocorrect="off"
        />
        <input
          type="text"
          id="phone"
          name="phone"
          placeholder="Phone"
          aria-label="Phone (###) ###-####)"
        />
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Message"
          required
          aria-label="Message"></textarea>
        <button type="submit" class="cta-button">Send Message</button>
      </form>
      <p class="non-confidential-note">
        Messages sent through this form are NOT confidential. Please avoid
        sending private or confidential information.
      </p>
    </section>
  </main>
</MainLayout>

<style>
  .contact-hero {
    text-align: center;
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .contact-hero h1 {
    font-size: 2.5rem;
    color: var(--color-charcoal);
  }
  .contact-hero p {
    color: var(--color-slate);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }
  .contact-hero-divider {
    border: none;
    border-top: 1px solid var(--color-charcoal);
    width: 20%; /* Adjust as needed */
    margin: 1.5rem auto; /* Center the line and provide vertical spacing */
  }
  .contact-form-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .contact-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background-color: var(--color-white);
    border-radius: 12px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
  }
  .contact-form input,
  .contact-form textarea {
    padding: 0.8rem;
    border: 1px solid var(--color-slate);
    border-radius: 4px;
    font-size: 1rem;
  }
  .contact-form textarea {
    resize: vertical;
  }
  .cta-button {
    background-color: var(--color-accent);
    color: var(--color-charcoal);
    padding: 0.8rem 2rem;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    align-self: flex-start; /* Align button to the start of the flex container */
  }
  .cta-button:hover {
    background-color: var(--color-accent);
    filter: brightness(1.1);
  }
  .non-confidential-note {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-slate);
    text-align: center;
    margin-top: 1rem;
    max-width: 80%;
    line-height: 1.4;
  }
</style>

<script>
  import IMask from "imask";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const phoneInput = document.getElementById("phone") as HTMLInputElement;
  const messageText = document.getElementById("message") as HTMLTextAreaElement;

  if (form && nameInput && emailInput && phoneInput && messageText) {
    // Initialize IMask for phone number input
    const phoneMask = IMask(phoneInput, {
      mask: "(000) 000-0000",
      lazy: true, // Keeps the field clean and truly empty when unfilled
      prepare: (value, masked) => {
        if (value.startsWith("+1")) {
          return value.substring(2); // Remove the "+1"
        } else if (value.startsWith("1") && value.length > 10) {
          return value.substring(1); // Remove the "1" if it's an extra digit
        }
        return value;
      },
    });

    // Clear the error immediately when IMask detects ANY change
    phoneMask.on("accept", () => {
      phoneInput.setCustomValidity("");
    });

    form.addEventListener("submit", (event) => {
      // Check if user actually typed digits
      const phoneInputChanged = phoneMask.unmaskedValue.length > 0;

      if (phoneInputChanged) {
        // If they typed something but it's incomplete, flag it
        if (!phoneMask.masked.isComplete) {
          event.preventDefault(); // Stop form submission

          phoneInput.setCustomValidity(
            "Please enter a complete 10-digit phone number: (###) ###-####",
          );
          phoneInput.reportValidity();
        } else {
          phoneInput.setCustomValidity("");
        }
      } else {
        // If it's completely empty, ensure it's completely valid
        phoneInput.setCustomValidity("");
      }

      console.log(
        nameInput.value +
          ", " +
          emailInput.value +
          ", " +
          phoneInput.value +
          ", " +
          messageText.value,
      );
    });
  }
</script>
